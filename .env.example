# Core application
APP_NAME=Prism
APP_ENV=development
# For a locally installed PostgreSQL instance, replace the password placeholder.
# Compose overrides this value and builds its connection string from PRISM_DATABASE_PASSWORD.
DATABASE_URL=postgresql+psycopg://prism:replace-with-a-local-password@localhost:5432/prism
MANAGER_TIMEZONE=UTC
AGENT_SIGNATURE=Sent by Prism

# Prism v2.1 web agent. Keep disabled until the v2.1 release gate passes.
PRISM_V21_ENABLED=false
# Maximum recent messages read from the explicitly selected Teams chat for one agent job.
V21_TEAMS_MESSAGE_LIMIT=50
V21_TEAMS_SOURCE_LIMIT=5
V21_TEAMS_HISTORY_DAYS=30
V21_TEAMS_EVIDENCE_CHARACTER_LIMIT=60000
V22_TEAMS_POLL_SOURCE_LIMIT=8
V22_TEAMS_POLL_MESSAGE_LIMIT=100
V22_TEAMS_EVENT_LIMIT=100
# Keep model refinement off during local development unless you want a configured provider
# to review already-filtered Teams risk candidates. Deterministic evidence checks still run.
V22_SIGNAL_MODEL_ENABLED=false
V22_SIGNAL_UNANSWERED_HOURS=4
V22_SIGNAL_LOOKBACK_HOURS=168
V22_SIGNAL_CANDIDATE_LIMIT=40
# Local Prism scheduler. Keep disabled until you explicitly want scheduled or continuous polling.
PRISM_V22_SCHEDULER_ENABLED=false
PRISM_V22_SCHEDULER_INTERVAL_SECONDS=60
PRISM_V22_SCHEDULER_GLOBAL_CONCURRENCY=1
PRISM_V22_SCHEDULER_LEASE_SECONDS=180
PRISM_V22_SCHEDULE_CATCH_UP_SECONDS=3600

# Prism v2.2 multi-Prism workspace. Keep disabled until its release gate passes.
# Phase 0 only establishes feature isolation; it does not enable monitoring or schedules.
PRISM_V22_ENABLED=false
PRISM_V22_SINGLE_EXECUTIVE_MODE=false

# Used by compose.yaml for the local PostgreSQL container only. Set a unique local password.
PRISM_DATABASE_PASSWORD=

# Microsoft Teams / Graph. Leave blank until the Entra app is configured.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/microsoft/auth/callback
# Public HTTPS base URL used by Microsoft Graph webhooks, without a trailing slash.
MICROSOFT_WEBHOOK_BASE_URL=
# Fernet key used to encrypt Microsoft access and refresh tokens in PostgreSQL.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MICROSOFT_TOKEN_ENCRYPTION_KEY=
# Optional separate Fernet key for UI-managed BYOK credentials. When blank, Prism reuses the
# Microsoft token encryption key above.
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

# Required in production and whenever MICROSOFT_WEBHOOK_BASE_URL is configured.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATOR_API_TOKEN=

# Azure OpenAI. Keep disabled until all required values are configured.
INTELLIGENCE_LLM_ENABLED=false
# Provider options: azure_openai, openai, or codex_local. Automated tests inject a fake provider.
LLM_PROVIDER=azure_openai
# Optional generic model names. If blank, the Azure deployment values below are used.
LLM_MODEL=
LLM_REASONING_MODEL=
# Standard OpenAI BYOK configuration. Prism never reads ~/.codex/auth.json.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Development-only Codex CLI provider. Prism never parses this file; the CLI owns authentication.
CODEX_CLI_PATH=codex
CODEX_AUTH_PATH=~/.codex/auth.json
# Local structured Codex runs need longer than normal HTTP model calls.
CODEX_TIMEOUT_SECONDS=120
CODEX_TOTAL_TIMEOUT_SECONDS=180
CODEX_MAX_ATTEMPTS=1
# Provider-neutral request policy. Values apply to either adapter.
LLM_TIMEOUT_SECONDS=25
LLM_TOTAL_TIMEOUT_SECONDS=40
LLM_MAX_ATTEMPTS=2
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_REASONING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TIMEOUT_SECONDS=25
AZURE_OPENAI_TOTAL_TIMEOUT_SECONDS=40
AZURE_OPENAI_MAX_ATTEMPTS=2
RESPONSE_POLICY_VERSION=2026-09-18.1
# JSON keyed by model or deployment name; prices are USD per one million tokens.
# USD per 1M tokens, keyed by model or deployment name, e.g.
# LLM_MODEL_PRICING={"gpt-5-nano":{"input":0.05,"cached_input":0.005,"output":0.40}}
LLM_MODEL_PRICING={}
AGENT_CONTEXT_TURNS=12
AGENT_CONTEXT_ISSUES=8

# Automation. The scheduler is intentionally disabled by default.
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_SCHEDULER_INTERVAL_SECONDS=60
DAILY_CHECKIN_TIME=10:00
DAILY_FOLLOWUP_TIME=13:00
DAILY_DIGEST_TIME=19:30
DIGEST_DUE_SOON_HOURS=48
# Optional Microsoft directory email used for manager notifications.
MANAGER_NOTIFICATION_EMAIL=

# Organisational memory. Full-text retrieval works without embeddings.
MEMORY_ENGINE_ENABLED=true
MEMORY_EMBEDDINGS_ENABLED=false
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
MEMORY_CONTEXT_MAX_FACTS=8
MEMORY_CONTEXT_MAX_EPISODES=4
MEMORY_CONTEXT_MAX_RELATIONS=6
MEMORY_CONTEXT_MAX_EVIDENCE=5
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_TIME=02:00
MANAGEMENT_CONTEXT_MAX_ENTRIES=60
MANAGEMENT_RESPONSE_CONTEXT_MAX_ENTRIES=8
