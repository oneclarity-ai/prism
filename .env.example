# Core application
APP_NAME=Prism
APP_ENV=development
DATABASE_URL=postgresql+psycopg://prism:change-me@localhost:5432/prism
MANAGER_TIMEZONE=UTC
AGENT_SIGNATURE=Sent by Prism

# Used by compose.yaml for the local PostgreSQL container only.
PRISM_DATABASE_PASSWORD=change-me

# Microsoft Teams / Graph. Leave blank until the Entra app is configured.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/microsoft/auth/callback
# Public HTTPS base URL used by Microsoft Graph webhooks, without a trailing slash.
MICROSOFT_WEBHOOK_BASE_URL=
# Fernet key used to encrypt Microsoft access and refresh tokens in PostgreSQL.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MICROSOFT_TOKEN_ENCRYPTION_KEY=

# Required in production and whenever MICROSOFT_WEBHOOK_BASE_URL is configured.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
OPERATOR_API_TOKEN=

# Azure OpenAI. Keep disabled until all required values are configured.
INTELLIGENCE_LLM_ENABLED=false
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_REASONING_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TIMEOUT_SECONDS=25
AZURE_OPENAI_TOTAL_TIMEOUT_SECONDS=40
AZURE_OPENAI_MAX_ATTEMPTS=2
RESPONSE_POLICY_VERSION=2026-09-18.1
# JSON keyed by model or deployment name; prices are USD per one million tokens.
LLM_MODEL_PRICING={}
AGENT_CONTEXT_TURNS=12
AGENT_CONTEXT_ISSUES=8

# Automation. The scheduler is intentionally disabled by default.
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_SCHEDULER_INTERVAL_SECONDS=60
DAILY_CHECKIN_TIME=10:00
DAILY_FOLLOWUP_TIME=13:00
DAILY_DIGEST_TIME=19:30
DIGEST_DUE_SOON_HOURS=48
# Optional Microsoft directory email used for manager notifications.
MANAGER_NOTIFICATION_EMAIL=

# Organisational memory. Full-text retrieval works without embeddings.
MEMORY_ENGINE_ENABLED=true
MEMORY_EMBEDDINGS_ENABLED=false
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
MEMORY_CONTEXT_MAX_FACTS=8
MEMORY_CONTEXT_MAX_EPISODES=4
MEMORY_CONTEXT_MAX_RELATIONS=6
MEMORY_CONTEXT_MAX_EVIDENCE=5
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_TIME=02:00
MANAGEMENT_CONTEXT_MAX_ENTRIES=60
MANAGEMENT_RESPONSE_CONTEXT_MAX_ENTRIES=8
