APP_NAME=Yash Manager Agent
APP_ENV=development
DATABASE_URL=postgresql+psycopg://yash_manager:<password>@localhost:5432/yash_manager_db

# Microsoft Teams / Graph (leave empty until the Entra app is configured)
MICROSOFT_TENANT_ID=<Softtrine-tenant-ID>
MICROSOFT_CLIENT_ID=<application-client-ID>
MICROSOFT_CLIENT_SECRET=<development-client-secret>
MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/microsoft/auth/callback
# The public HTTPS tunnel or deployment URL used by Microsoft Graph webhooks.
MICROSOFT_WEBHOOK_BASE_URL=https://<reserved-subdomain>.ngrok.app
# Generate locally; this encrypts Microsoft refresh/access tokens stored in PostgreSQL.
MICROSOFT_TOKEN_ENCRYPTION_KEY=<Fernet-key>
# Required whenever MICROSOFT_WEBHOOK_BASE_URL exposes this app through ngrok
# or a deployment. Enter the same value with the dashboard's key icon.
OPERATOR_API_TOKEN=<long-random-local-token>

# Azure OpenAI (leave empty until the first management-analysis loop is configured)
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=<azure-openai-key>
# This is your deployment name, not necessarily the underlying model name.
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
# Optional stronger deployment for ambiguous, multi-issue, or multi-owner replies.
AZURE_OPENAI_REASONING_DEPLOYMENT=
INTELLIGENCE_LLM_ENABLED=true
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_TIMEOUT_SECONDS=25
AZURE_OPENAI_TOTAL_TIMEOUT_SECONDS=40
AZURE_OPENAI_MAX_ATTEMPTS=2
RESPONSE_POLICY_VERSION=2026-09-18.1
# JSON keyed by the provider's returned model name or your deployment name.
# Prices are USD per 1 million tokens. Leave {} to record tokens as unpriced.
# LLM_MODEL_PRICING={"<model-or-deployment>":{"input":0,"cached_input":0,"output":0}}
LLM_MODEL_PRICING={}
AGENT_CONTEXT_TURNS=12
AGENT_CONTEXT_ISSUES=8
# Used only to interpret an ETA that omits a timezone, for example "today at 4 PM".
MANAGER_TIMEZONE=Asia/Kolkata

# Leave false while testing. The in-process scheduler only runs while Uvicorn is running.
AUTOMATION_SCHEDULER_ENABLED=false
AUTOMATION_SCHEDULER_INTERVAL_SECONDS=60
DAILY_CHECKIN_TIME=10:00
DAILY_FOLLOWUP_TIME=13:00
DAILY_DIGEST_TIME=19:30
DIGEST_DUE_SOON_HOURS=48
# Optional Teams target for the manager digest and escalation alerts.
YASH_NOTIFICATION_EMAIL=<yash-email-in-softtrine>

# Organisational memory. Full-text retrieval works without embeddings.
MEMORY_ENGINE_ENABLED=true
MEMORY_EMBEDDINGS_ENABLED=false
# Set this only after creating an Azure OpenAI embedding deployment.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
MEMORY_CONTEXT_MAX_FACTS=8
MEMORY_CONTEXT_MAX_EPISODES=4
MEMORY_CONTEXT_MAX_RELATIONS=6
MEMORY_CONTEXT_MAX_EVIDENCE=5
MEMORY_CONSOLIDATION_ENABLED=true
MEMORY_CONSOLIDATION_TIME=02:00
MANAGEMENT_CONTEXT_MAX_ENTRIES=60
# Only the most relevant saved policies are supplied to one response decision.
MANAGEMENT_RESPONSE_CONTEXT_MAX_ENTRIES=8
