# Copy to .env (scripts/setup.sh does this and fills the two keys for you).
# Never commit .env. Every value here has a default in app/core/config.py unless marked REQUIRED.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false
# LOG_DIR=./var/logs          # JSON log files; empty disables
# LOG_SQL=false               # true prints every SQL statement

DATABASE_URL=postgresql+asyncpg://localhost:5432/oneclarity

# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# REQUIRED. Encrypts stored secrets. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the same key for the life of a database, or stored secrets can no longer be read.
SECRET_ENCRYPTION_KEY=

CORS_ORIGINS=["http://localhost:5173"]

# Azure OpenAI (REQUIRED for the real agent; without it use the agent runtime "Fake")
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Cost estimate (USD per 1M tokens): set to your Azure prices. Cached input defaults to 10% of input.
AZURE_PRICE_INPUT_PER_1M=0.25
AZURE_PRICE_OUTPUT_PER_1M=2.00
AZURE_PRICE_CACHED_INPUT_PER_1M=0.025
AZURE_MODEL_PRICING={"gpt-5-mini":{"input":0.25,"cached_input":0.025,"output":2.00},"gpt-5-nano":{"input":0.05,"cached_input":0.005,"output":0.40}}
# AZURE_PRICE_CACHED_INPUT_PER_1M=

# Cost controls (see docs/27-cost-optimization.md)
# AZURE_REASONING_EFFORT=low     # minimal | low | medium | high; empty = model default
# AZURE_VERBOSITY=low
# AZURE_MAX_RETRIES=6
# CONTEXT_KEEP_RECENT_OUTPUTS=4

# Browser tool (Playwright MCP, started with npx; needs Google Chrome)
# BROWSER_HEADLESS=true          # false opens a visible Chrome window per run

# Runs and worker
# MAX_CONCURRENT_RUNS=4
# RUN_TIMEOUT_SEC=1800
# PARALLEL_DEFAULT_AGENTS=3
# SUBAGENT_MAX_TURNS=80
# SUBAGENT_BUDGET_USD=1.0

# First admin created by `python -m app.db.seed`
SEED_ADMIN_EMAIL=admin@oneclarity.local
SEED_ADMIN_PASSWORD=change-me-now

# Computers (v2.4): one Docker container per agent with a "computer" grant (needs Docker running on this machine)
COMPUTER_IMAGE=mcr.microsoft.com/playwright/mcp
COMPUTER_IDLE_MINUTES=10
# COMPUTER_ALLOW_LOCAL_SITES=false  # dev-only: permits localhost/private browser destinations
# RUN_LEASE_SECONDS=30
# Teams tools of a Prism's agent call back into Prism, signed with this secret (same as Prism's WORK_BRIDGE_SECRET)
PRISM_BRIDGE_URL=http://127.0.0.1:8000
PRISM_BRIDGE_SECRET=
